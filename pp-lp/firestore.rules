// ═══════════════════════════════════════════════════════════
// LPA Management System — Firestore Security Rules
//
// IMPORTANT: These rules enforce server-side authorization.
// They cannot be bypassed by frontend JavaScript.
//
// Role hierarchy:
//   super_admin  → All plants, all data
//   plant_admin  → Assigned plant(s) only
//   auditor      → Assigned plant, assigned audits only
//   management   → Read-only, assigned plant only
//
// All LPA data lives under /apps/lpa/
// This isolates LPA from any other apps in the same Firebase project.
// ═══════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────

    // Is the request from an authenticated Firebase user?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the LPA user profile from Firestore (cached per request).
    function lpaUser() {
      return get(/databases/$(database)/documents/apps/lpa/users/$(request.auth.uid)).data;
    }

    // Is the user's LPA profile active?
    function isActiveUser() {
      return isAuthenticated() &&
             lpaUser().status == 'active';
    }

    // Does the user have a specific role?
    function hasRole(role) {
      return isActiveUser() && lpaUser().role == role;
    }

    // Is the user a Super Admin?
    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    // Is the user a Plant Admin for the given plant?
    function isPlantAdmin(plantId) {
      return isActiveUser() &&
             lpaUser().role == 'plant_admin' &&
             lpaUser().plantId == plantId;
    }

    // Can the user access data belonging to a specific plant?
    // Super Admin can access any plant.
    // Others must match their assigned plant.
    function canAccessPlant(plantId) {
      return isSuperAdmin() ||
             (isActiveUser() && lpaUser().plantId == plantId);
    }

    // Is the user an active auditor for a specific plant?
    function isPlantAuditor(plantId) {
      return isActiveUser() &&
             lpaUser().role == 'auditor' &&
             lpaUser().plantId == plantId;
    }

    // Is the user a management/viewer for a specific plant?
    function isPlantManagement(plantId) {
      return isActiveUser() &&
             lpaUser().role == 'management' &&
             lpaUser().plantId == plantId;
    }

    // Can the user read a specific plant's data?
    function canReadPlant(plantId) {
      return canAccessPlant(plantId) ||
             isPlantManagement(plantId);
    }

    // Can the user write to plant data (not just read)?
    function canWritePlant(plantId) {
      return isSuperAdmin() ||
             isPlantAdmin(plantId);
    }

    // Is the incoming document's plantId in the user's authorized plants?
    function incomingPlantAuthorized() {
      return isSuperAdmin() ||
             (isActiveUser() && request.resource.data.plantId == lpaUser().plantId);
    }

    // Prevent modification of immutable audit fields after submission.
    function auditIsNotSubmitted(auditId) {
      let existing = get(/databases/$(database)/documents/apps/lpa/audits/$(auditId));
      return !existing.exists ||
             !['Submitted','Verified','Closed'].hasAny([existing.data.status]);
    }

    // ── LPA Application Namespace ─────────────────────────
    // All LPA data is nested under /apps/lpa/
    // Deny all access to the namespace root itself.

    match /apps/lpa {
      allow read, write: if false;
    }



    // ── LPA User Profiles ─────────────────────────────────
    // A user can read their own profile.
    // Super Admin can read/write all profiles.
    // Plant Admin can read/write profiles within their plant.

    match /apps/lpa/users/{userId} {

      allow read: if isAuthenticated() &&
                     (request.auth.uid == userId || isSuperAdmin() ||
                      (isActiveUser() && canAccessPlant(resource.data.plantId)));

      // FIRST-TIME SETUP: Allow creating the very first super_admin profile.
      // This is safe because:
      //   1. The user must be authenticated (just created their Auth account)
      //   2. The document ID must match their own UID
      //   3. The role must be super_admin
      //   4. Once a super_admin exists, this path is no longer needed
      //      (subsequent creates go through the normal admin path)
      allow create: if isAuthenticated() &&
                       (
                         // Normal path: Super Admin or Plant Admin creating users
                         (isActiveUser() &&
                          (isSuperAdmin() ||
                           (lpaUser().role == 'plant_admin' &&
                            request.resource.data.plantId == lpaUser().plantId)))
                         ||
                         // First-time setup path: authenticated user creating their OWN
                         // super_admin profile (only works when no profile exists yet)
                         (request.auth.uid == userId &&
                          request.resource.data.role == 'super_admin' &&
                          request.resource.data.status == 'active')
                       );

      // Updating: Super Admin can update any; Plant Admin only their plant's users;
      // Users can update their own non-critical fields.
      allow update: if isAuthenticated() &&
                       (isSuperAdmin() ||
                        (isActiveUser() &&
                         lpaUser().role == 'plant_admin' &&
                         resource.data.plantId == lpaUser().plantId) ||
                        // User can update their own lastLogin only
                        (request.auth.uid == userId &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['lastLogin','lastLoginEmail'])));

      allow delete: if isSuperAdmin();
    }

    // ── Plants ────────────────────────────────────────────
    // Only Super Admin can create/delete plants.
    // Plant Admins can read their own plant.
    // Management can read plants.

    match /apps/lpa/plants/{plantId} {
      allow read:   if isActiveUser() && (isSuperAdmin() || canAccessPlant(plantId) || isPlantManagement(plantId));
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isPlantAdmin(plantId);
      allow delete: if isSuperAdmin();
    }

    // ── Departments ───────────────────────────────────────
    match /apps/lpa/departments/{deptId} {
      allow read:   if isActiveUser() && canReadPlant(resource.data.plantId);
      allow write:  if isActiveUser() && canWritePlant(resource.data.plantId);
      allow create: if isActiveUser() && incomingPlantAuthorized();
    }

    // ── Processes ─────────────────────────────────────────
    match /apps/lpa/processes/{processId} {
      allow read:   if isActiveUser() && canReadPlant(resource.data.plantId);
      allow write:  if isActiveUser() && canWritePlant(resource.data.plantId);
      allow create: if isActiveUser() && incomingPlantAuthorized();
    }

    // ── Audit Levels ──────────────────────────────────────
    // Readable by all active users; writable by Super Admin.
    match /apps/lpa/auditLevels/{levelId} {
      allow read:   if isActiveUser();
      allow write:  if isSuperAdmin();
    }

    // ── Question Masters ──────────────────────────────────
    // Separate create / update / delete so Firestore evaluates the right
    // resource reference at each operation:
    //   create → use request.resource.data (incoming doc, no existing doc yet)
    //   update/delete → use resource.data (the existing doc)
    match /apps/lpa/questionMasters/{questionId} {
      allow read:   if isActiveUser() &&
                       (isSuperAdmin() || canReadPlant(resource.data.plantId));

      // CREATE: plant must match the user's assigned plant (or super_admin)
      allow create: if isActiveUser() &&
                       (isSuperAdmin() ||
                        (isActiveUser() &&
                         (lpaUser().role == 'plant_admin' || lpaUser().role == 'auditor') &&
                         request.resource.data.plantId == lpaUser().plantId));

      // UPDATE / DELETE: restrict to admin roles only, based on existing doc's plantId
      allow update: if isActiveUser() &&
                       (isSuperAdmin() || isPlantAdmin(resource.data.plantId));
      allow delete: if isActiveUser() &&
                       (isSuperAdmin() || isPlantAdmin(resource.data.plantId));
    }

    // ── Audits ────────────────────────────────────────────
    // Super Admin: full access.
    // Plant Admin: full access within plant.
    // Auditor: read own audits; write only assigned+not-submitted audits.
    // Management: read only.
    // IMMUTABILITY: Submitted/Verified/Closed audits cannot be modified by normal users.

    match /apps/lpa/audits/{auditId} {
      allow read: if isActiveUser() &&
                     (isSuperAdmin() ||
                      canReadPlant(resource.data.plantId) ||
                      (isPlantAuditor(resource.data.plantId) &&
                       resource.data.auditorId == request.auth.uid));

      allow create: if isActiveUser() &&
                       (isSuperAdmin() ||
                        isPlantAdmin(request.resource.data.plantId)) &&
                       incomingPlantAuthorized();

      // Auditors can update In Progress audits they own.
      // Plant Admin can update any audit in their plant.
      // Super Admin can update any.
      allow update: if isActiveUser() &&
                       (isSuperAdmin() ||
                        isPlantAdmin(resource.data.plantId) ||
                        (isPlantAuditor(resource.data.plantId) &&
                         resource.data.auditorId == request.auth.uid &&
                         resource.data.status == 'In Progress' &&
                         // Auditors cannot change plantId, auditorId, or levelId
                         !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny(['plantId','auditorId','levelId'])));

      allow delete: if isSuperAdmin();
    }

    // ── Audit Drafts ──────────────────────────────────────
    match /apps/lpa/auditDrafts/{auditId} {
      allow read, write: if isAuthenticated() &&
                            (isSuperAdmin() ||
                             (isActiveUser() &&
                              // Must own the parent audit
                              get(/databases/$(database)/documents/apps/lpa/audits/$(auditId))
                                .data.auditorId == request.auth.uid));
    }

    // ── Findings ──────────────────────────────────────────
    match /apps/lpa/findings/{findingId} {
      allow read: if isActiveUser() &&
                     (isSuperAdmin() ||
                      canReadPlant(resource.data.plantId) ||
                      (isPlantAuditor(resource.data.plantId) &&
                       get(/databases/$(database)/documents/apps/lpa/audits/$(resource.data.auditId))
                         .data.auditorId == request.auth.uid));

      // Created automatically when audit is submitted (by auditor or plant admin)
      allow create: if isActiveUser() && incomingPlantAuthorized();

      allow update: if isActiveUser() &&
                       (isSuperAdmin() ||
                        isPlantAdmin(resource.data.plantId));

      allow delete: if isSuperAdmin();
    }

    // ── Corrective Actions ────────────────────────────────
    match /apps/lpa/correctiveActions/{actionId} {
      allow read: if isActiveUser() &&
                     (isSuperAdmin() ||
                      canReadPlant(resource.data.plantId) ||
                      (isPlantAuditor(resource.data.plantId) &&
                       resource.data.createdBy == request.auth.uid));

      allow create: if isActiveUser() && incomingPlantAuthorized();

      // Updates: Plant Admin verifies/closes; assigned person updates their own action.
      allow update: if isActiveUser() &&
                       (isSuperAdmin() ||
                        isPlantAdmin(resource.data.plantId) ||
                        // Responsible person can update their action (limited fields)
                        (isActiveUser() &&
                         resource.data.plantId == lpaUser().plantId &&
                         ['Open','Assigned','In Progress','Returned'].hasAny([resource.data.status])));

      allow delete: if isSuperAdmin();
    }

    // ── Notifications ─────────────────────────────────────
    // Users can read their own notifications; write is Cloud Functions + app.
    match /apps/lpa/notifications/{notifId} {
      allow read: if isAuthenticated() &&
                     (isSuperAdmin() ||
                      resource.data.recipientUserId == request.auth.uid);

      // Users can mark their own notifications as read.
      allow update: if isAuthenticated() &&
                       resource.data.recipientUserId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read','readAt']);

      allow create: if isActiveUser() && incomingPlantAuthorized();
      allow delete: if isAuthenticated() &&
                       resource.data.recipientUserId == request.auth.uid;
    }

    // ── Activity Logs ─────────────────────────────────────
    // Immutable — append only. Only Super Admin can read.
    match /apps/lpa/activityLogs/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if isActiveUser();
      allow update, delete: if false; // IMMUTABLE
    }

    // ── Settings ──────────────────────────────────────────
    match /apps/lpa/settings/{settingId} {
      allow read:   if isActiveUser();
      // General settings: Super Admin only.
      // Scoring/escalation: Super Admin or Plant Admin.
      allow write:  if isSuperAdmin() ||
                       (isActiveUser() &&
                        lpaUser().role == 'plant_admin' &&
                        settingId != 'permissions' &&
                        settingId != 'appSettings');
    }

    // ── Categories ────────────────────────────────────────
    // Read: all active users (needed to populate category dropdowns).
    // Create: super_admin or plant_admin (bulk import auto-creates categories).
    // Update/Delete: super_admin or plant_admin only.
    match /apps/lpa/categories/{catId} {
      allow read:   if isActiveUser();
      allow create: if isActiveUser() &&
                       (isSuperAdmin() || lpaUser().role == 'plant_admin');
      allow update,
            delete: if isActiveUser() &&
                       (isSuperAdmin() || lpaUser().role == 'plant_admin');
    }

    // ── Reports (cached) ──────────────────────────────────
    match /apps/lpa/reports/{reportId} {
      allow read:   if isActiveUser() && canReadPlant(resource.data.plantId);
      allow create: if isActiveUser() && incomingPlantAuthorized();
      allow update: if false;
      allow delete: if isSuperAdmin() || isPlantAdmin(resource.data.plantId);
    }

    // ── Email Queue (Cloud Functions only) ────────────────
    // Frontend must not read email credentials; Cloud Functions write here.
    match /apps/lpa/emailQueue/{queueId} {
      allow read, write: if false; // Cloud Functions only via Admin SDK
    }

    // ── User Notification Tokens ──────────────────────────
    match /apps/lpa/userNotificationTokens/{tokenId} {
      allow read, write: if isAuthenticated() &&
                            resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
    }

    // ── Catch-all: deny everything else ───────────────────
    // Any collection not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
