{
  "rules": {
    "responses": {
      ".read": "auth != null",
      "$responseId": {
        ".write": "!data.exists() || auth != null"
      }
    },
    "usedCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "!data.exists()"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "config": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
