{
  "name": "price-proposal-approval-system",
  "version": "1.0.0",
  "description": "Multi-plant Price Proposal Approval Management System",
  "private": true,
  "scripts": {
    "serve": "firebase emulators:start --only hosting,firestore,auth",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:all": "firebase deploy --only hosting,firestore:rules,firestore:indexes,storage",
    "setup:env": "node scripts/setup-env.js"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0"
  }
}
