rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Bill uploads — authenticated users can upload; path scoped to plant
    match /bills/{plantId}/{vehicleId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // Max 10MB
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|jpg|png))');
      allow delete: if request.auth != null;
    }

    // Bulk upload CSVs (temporary)
    match /bulk_uploads/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Reports output
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions only
    }
  }
}
