rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    function isPlantAdmin(plantId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'plant_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plantId == plantId;
    }
    function canAccessPlant(plantId) {
      return isSuperAdmin() || isPlantAdmin(plantId);
    }

    // Users collection — admins can read own data; superadmin can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
      allow create: if isSuperAdmin();
    }

    // Plants — superadmin full access; plant admins read-only
    match /plants/{plantId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Vehicles — plant admins can CRUD their own plant's vehicles
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && canAccessPlant(resource.data.plantId);
      allow delete: if isSuperAdmin();
    }

    // Expenses — plant admins can CRUD their plant's expenses; read-only for other plants
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canAccessPlant(request.resource.data.plantId);
      allow update: if isAuthenticated() && canAccessPlant(resource.data.plantId);
      allow delete: if isSuperAdmin();
    }

    // Bills/attachments metadata
    match /bills/{billId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // Alerts — read for all authenticated; write only via Cloud Functions
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedBy', 'acknowledgedAt']);
      allow write: if false; // Only via Cloud Functions
    }

    // Monthly/weekly reports — read-only for authenticated
    match /monthly_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /weekly_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Notifications — read for admins, write via Cloud Functions
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy', 'readAt']);
      allow write: if false;
    }

    // Audit log — read for superadmin; write via Cloud Functions only
    match /audit_log/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Management tokens — superadmin only
    match /mgmt_tokens/{tokenId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
