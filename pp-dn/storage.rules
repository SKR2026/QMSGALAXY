rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Document uploads
    match /documents/{userId}/{docId}/{fileName} {
      // Allow read if authenticated user is the owner, corporate MR, or superadmin
      allow read: if isAuthenticated();

      // Allow upload only by authenticated users for their own folder
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.size < 50 * 1024 * 1024 && // 50MB limit
        request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\..*|vnd\\.ms-excel|vnd\\.ms-powerpoint)|image/.*');

      // Allow update by owner when document is in draft/returned state
      allow update: if isAuthenticated() && request.auth.uid == userId;

      // Only superadmin can delete storage files
      allow delete: if request.auth.token.role == 'superadmin';
    }

    // Company logos and branding
    match /branding/{fileName} {
      allow read: if true; // Public read for logo
      allow write: if isAuthenticated(); // Superadmin enforced at app level
    }
  }
}
