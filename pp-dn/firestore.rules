rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return isAuthenticated() && !isAnonymous() && getUserData().role == 'superadmin';
    }

    function isCorporateMR() {
      return isAuthenticated() && !isAnonymous() && getUserData().role == 'corporate_mr';
    }

    function isUser() {
      return isAuthenticated() && !isAnonymous() && getUserData().role == 'user';
    }

    function isActiveUser() {
      return isAuthenticated() && !isAnonymous() && getUserData().active == true;
    }

    // Users collection
    match /users/{userId} {
      // A user can always read their own doc; superadmin can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperadmin() || isAnonymous());

      // Allow create if:
      //  (a) superadmin is creating another user, OR
      //  (b) the user is creating their OWN doc (self-registration / first run)
      allow create: if isAuthenticated() && !isAnonymous() &&
        (isSuperadmin() || request.auth.uid == userId);

      allow update: if isAuthenticated() && !isAnonymous() &&
        (isSuperadmin() || request.auth.uid == userId);
      allow delete: if isSuperadmin();
    }

    // Plants collection
    match /plants/{plantId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    // Document Categories
    match /documentCategories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    // Documents collection - core business logic
    match /documents/{docId} {
      // Top management (anonymous) gets full read access
      allow read: if isAuthenticated() && (
        isAnonymous() ||
        isSuperadmin() ||
        isCorporateMR() ||
        (isUser() && resource.data.submittedBy == request.auth.uid)
      );

      // Allow any active authenticated non-anonymous user to create a document
      allow create: if isAuthenticated() && !isAnonymous() && isActiveUser();

      allow update: if isAuthenticated() && (
        isSuperadmin() ||
        isCorporateMR() ||
        (isUser() &&
          resource.data.submittedBy == request.auth.uid &&
          (resource.data.status == 'draft' ||
           resource.data.status == 'returned_for_correction'))
      );

      // Only superadmin can delete
      allow delete: if isSuperadmin();
    }

    // Document Number Registry - critical uniqueness control
    match /documentNumberRegistry/{docNumber} {
      allow read: if isAuthenticated() && (isAnonymous() || isSuperadmin() || isCorporateMR());
      allow create: if isAuthenticated() && isCorporateMR();
      allow update: if isSuperadmin();
      allow delete: if isSuperadmin();
    }

    // Notification Queue
    match /notificationQueue/{queueId} {
      allow read: if isAuthenticated() && (isSuperadmin() || isCorporateMR() ||
        (isUser() && resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated() && !isAnonymous();
      allow update: if isAuthenticated() && (isSuperadmin() || isCorporateMR());
      allow delete: if isSuperadmin();
    }

    // Notification Logs
    match /notificationLogs/{logId} {
      allow read: if isAuthenticated() && (isSuperadmin() || isCorporateMR());
      allow create: if isAuthenticated() && !isAnonymous();
      allow update: if isSuperadmin();
      allow delete: if isSuperadmin();
    }

    // Activity Logs - append only for authenticated users, read for admins
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && isSuperadmin();
      allow create: if isAuthenticated() && !isAnonymous();
      allow update: if false;
      allow delete: if isSuperadmin();
    }

    // App Settings
    match /appSettings/{settingId} {
      // Email credentials only accessible by superadmin
      allow read: if settingId == "emailCredentials"
        ? isSuperadmin()
        : isAuthenticated();
      // refCounter is written by Cloud Functions (Admin SDK bypasses rules)
      // branding/notifications writable by superadmin; also allow authenticated on first run
      allow write: if isSuperadmin() ||
        (isAuthenticated() && !isAnonymous() && settingId == "branding");
    }

    // Deleted Records Archive
    match /deletedRecords/{recordId} {
      allow read: if isSuperadmin();
      allow create: if isSuperadmin();
      allow update: if isSuperadmin();
      allow delete: if false;
    }
  }
}
