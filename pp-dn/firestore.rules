rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return isAuthenticated() && getUserData().role == 'superadmin';
    }

    function isCorporateMR() {
      return isAuthenticated() && getUserData().role == 'corporate_mr';
    }

    function isUser() {
      return isAuthenticated() && getUserData().role == 'user';
    }

    function isActiveUser() {
      return isAuthenticated() && getUserData().active == true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperadmin());
      allow create: if isSuperadmin();
      allow update: if isSuperadmin() || request.auth.uid == userId;
      allow delete: if isSuperadmin();
    }

    // Plants collection
    match /plants/{plantId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    // Document Categories
    match /documentCategories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    // Documents collection - core business logic
    match /documents/{docId} {
      allow read: if isAuthenticated() && (
        isSuperadmin() ||
        isCorporateMR() ||
        (isUser() && resource.data.submittedBy == request.auth.uid)
      );

      allow create: if isAuthenticated() && isActiveUser() && isUser();

      allow update: if isAuthenticated() && (
        isSuperadmin() ||
        isCorporateMR() ||
        (isUser() &&
          resource.data.submittedBy == request.auth.uid &&
          (resource.data.status == 'draft' ||
           resource.data.status == 'returned_for_correction'))
      );

      // Only superadmin can delete
      allow delete: if isSuperadmin();
    }

    // Document Number Registry - critical uniqueness control
    match /documentNumberRegistry/{docNumber} {
      allow read: if isAuthenticated() && (isSuperadmin() || isCorporateMR());
      allow create: if isAuthenticated() && isCorporateMR();
      allow update: if isSuperadmin();
      allow delete: if isSuperadmin();
    }

    // Notification Queue
    match /notificationQueue/{queueId} {
      allow read: if isAuthenticated() && (isSuperadmin() || isCorporateMR() ||
        (isUser() && resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isSuperadmin() || isCorporateMR());
      allow delete: if isSuperadmin();
    }

    // Notification Logs
    match /notificationLogs/{logId} {
      allow read: if isAuthenticated() && (isSuperadmin() || isCorporateMR());
      allow create: if isAuthenticated();
      allow update: if isSuperadmin();
      allow delete: if isSuperadmin();
    }

    // Activity Logs - append only for authenticated users, read for admins
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && isSuperadmin();
      allow create: if isAuthenticated();
      allow update: if false; // No one can update logs
      allow delete: if isSuperadmin();
    }

    // App Settings
    match /appSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    // Deleted Records Archive
    match /deletedRecords/{recordId} {
      allow read: if isSuperadmin();
      allow create: if isSuperadmin();
      allow update: if isSuperadmin();
      allow delete: if false; // Cannot delete archive
    }
  }
}
