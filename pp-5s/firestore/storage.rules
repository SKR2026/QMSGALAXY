rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }

    // Audit evidence: /audits/{auditId}/{filename}
    match /audits/{auditId}/{allPaths=**} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn()
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Action evidence: /actions/{actionId}/{filename}
    match /actions/{actionId}/{allPaths=**} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Company logos: /org/{orgId}/logo
    match /org/{orgId}/{allPaths=**} {
      allow read:  if true;  // public
      allow write: if isSignedIn();
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
