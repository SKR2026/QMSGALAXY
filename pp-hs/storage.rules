rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ─── HIRA Documents ───
    match /hira/{hiraId}/{allPaths=**} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // Plant Admin, Assessor can upload (max 20MB per file)
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|application/msword|application/vnd.openxmlformats.*|text/.*');
    }

    // ─── Action Evidence ───
    match /actions/{actionId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }

    // ─── Company Logo / Branding ───
    match /branding/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
        // Add Super Admin check via custom claims in production
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
