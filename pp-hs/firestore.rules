rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/hira_users/$(request.auth.uid)).data; }
    function userRole() { return userDoc().role; }
    function isSuperAdmin() {
      let r = userRole().lower();
      return r == 'super admin' || r == 'superadmin';
    }
    function isCorporateOrAbove() {
      let r = userRole().lower();
      return r == 'super admin' || r == 'superadmin' || r == 'corporate ehs' || r == 'corporateehs';
    }
    function isPlantAdminOrAbove() {
      let r = userRole().lower();
      return r in ['super admin','superadmin','corporate ehs','corporateehs','plant admin','plantadmin'];
    }
    function isActiveUser() {
      return isSignedIn() && userDoc().status == 'Active';
    }
    function hasPlantAccess(plantId) {
      return isCorporateOrAbove() || plantId in userDoc().plantIds;
    }

    // ─── hira_users ───
    match /hira_users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isCorporateOrAbove());
      allow create: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isSuperAdmin() || (request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','plantIds','status']));
      allow delete: if isSuperAdmin();
    }

    // ─── hira_plants ───
    match /hira_plants/{plantId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // ─── hira_hiras ───
    match /hira_hiras/{hiraId} {
      allow read: if isSignedIn() && hasPlantAccess(resource.data.plantId);
      allow create: if isSignedIn() && isPlantAdminOrAbove() && hasPlantAccess(request.resource.data.plantId);
      allow update: if isSignedIn() && isPlantAdminOrAbove() && hasPlantAccess(resource.data.plantId);
      allow delete: if isSignedIn() && isSuperAdmin();

      match /approvals/{approvalId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isCorporateOrAbove();
        allow update, delete: if false;
      }
    }

    // ─── hira_actions ───
    match /hira_actions/{actionId} {
      allow read: if isSignedIn() && hasPlantAccess(resource.data.plantId);
      allow create: if isSignedIn() && isPlantAdminOrAbove() && hasPlantAccess(request.resource.data.plantId);
      allow update: if isSignedIn() && isPlantAdminOrAbove() && hasPlantAccess(resource.data.plantId);
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // ─── hira_notifications ───
    match /hira_notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ─── hira_auditLogs ───
    match /hira_auditLogs/{logId} {
      allow read: if isSignedIn() && isCorporateOrAbove();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ─── hira_settings ───
    match /hira_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // ─── hira_emailLogs ───
    match /hira_emailLogs/{logId} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Deny all others
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
